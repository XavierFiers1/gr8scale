<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>gr8scale</AssemblyName>
    <RootNamespace>Gr8scale</RootNamespace>
    <Version>1.0.0</Version>
    <Company>gr8scale</Company>
    <Product>gr8scale</Product>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Workstation GC + concurrent GC keeps working set lower for a small UI app
         that's mostly idle (Server GC is tuned for throughput, not memory). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF-native tray icon, replaces the WinForms NotifyIcon dependency -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.131" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF Resource so we can reference it via a pack:// URI from H.NotifyIcon -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
