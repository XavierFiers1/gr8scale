<Window x:Class="Gr8scale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gr8scale"
        Width="420"
        MinWidth="420"
        MinHeight="240"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Compact slider for the per-app rows -->
        <Style x:Key="CompactThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF000000" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CompactThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "+ Add app" / row remove button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-row "✕" remove -->
        <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="gr8scale" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Cursor="SizeAll"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click" ToolTip="Minimize to tray"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="✕" Click="Close_Click" ToolTip="Hide to tray"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="24,4,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Default slider + percentage -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Default" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                    <Slider x:Name="IntensitySlider" Grid.Row="1"
                            Style="{StaticResource SlickSlider}"
                            ValueChanged="DefaultSlider_ValueChanged"
                            Value="0"/>
                    <TextBlock x:Name="PercentLabel" Grid.Row="2"
                               Text="0%"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="28" FontWeight="Light"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>

                <!-- Section separator + label -->
                <Grid Grid.Row="1" Margin="0,18,0,8">
                    <TextBlock Text="Per-app" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </Grid>

                <!-- Profile rows -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11FFFFFF" CornerRadius="6" Margin="0,3" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Slider Grid.Column="2"
                                                Style="{StaticResource CompactSlider}"
                                                Value="{Binding Intensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="{Binding}"
                                                Margin="12,0,12,0"
                                                ValueChanged="ProfileSlider_ValueChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Intensity, StringFormat={}{0:F0}%}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" Width="38" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource RemoveBtn}"
                                                Content="✕"
                                                Tag="{Binding}"
                                                Margin="6,0,0,0"
                                                Click="RemoveProfile_Click"
                                                ToolTip="Remove"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add button -->
                <Button Grid.Row="3" Style="{StaticResource GhostBtn}" Content="+ Add app"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddApp_Click"/>

                <!-- Autostart -->
                <CheckBox x:Name="AutostartCheck"
                          Grid.Row="4"
                          Style="{StaticResource SlickCheck}"
                          Content="Start with Windows"
                          HorizontalAlignment="Left"
                          Margin="0,16,0,0"
                          Checked="Autostart_Checked"
                          Unchecked="Autostart_Unchecked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
