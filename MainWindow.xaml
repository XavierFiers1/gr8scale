<Window x:Class="Gr8scale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gr8scale"
        Width="380" Height="200"
        MinWidth="380" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Border Background="{StaticResource BgBrush}" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="gr8scale" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Cursor="SizeAll"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click" ToolTip="Minimize to tray"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="✕" Click="Close_Click" ToolTip="Hide to tray"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="24,4,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Slider + percentage -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Slider x:Name="IntensitySlider" Grid.Row="0"
                            Style="{StaticResource SlickSlider}"
                            ValueChanged="IntensitySlider_ValueChanged"
                            Value="0"/>
                    <TextBlock x:Name="PercentLabel" Grid.Row="1"
                               Text="0%"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="28" FontWeight="Light"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>

                <!-- Spacer -->
                <Grid Grid.Row="1" Height="6"/>

                <!-- Autostart -->
                <CheckBox x:Name="AutostartCheck"
                          Grid.Row="2"
                          Style="{StaticResource SlickCheck}"
                          Content="Start with Windows"
                          HorizontalAlignment="Left"
                          Checked="Autostart_Checked"
                          Unchecked="Autostart_Unchecked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
